# 编译产物
cpp/SprayTrajCore/build/
wpf/SprayTrajViewer/bin/
wpf/SprayTrajViewer/obj/
*.exe
*.dll
*.lib
*.exp
*.pdb
*.ilk
.vs/

# 回归中间产物（保留 10 个基础样本，其余由脚本生成，不入库）
cpp/_regress/*.csv
cpp/_regress/*.map
cpp/_regress/mask_*.pgm
cpp/_regress/dbg/
cpp/_regress/*.ply.plane*.ply
cpp/_regress/ls*.ply
cpp/_regress/tr.ply
cpp/_regress/tray_v*.ply
cpp/_regress/tray_f30.ply
cpp/_regress/tray_def.ply
cpp/_regress/uv_plane*.csv
cpp/_regress/*.png

# 验证过程的临时截图（正式验收图统一放 outputs/ 归档）
cpp/*.png
/recon_*.png
/*_check*.png

# SPRAYTRAJ_DUMP 倒出的调试图（在仓库根目录跑 driver 时会生成）
/mask_*.pgm
/uv_plane*.csv
cpp/_regress/thinbox*.ply

# 回归测试脚本的运行产物（基线文件入库，输出不入库）
cpp/_regress/regress_out/
cpp/_regress/regress_old/

# 回归临时中间产物（调试用，_ 前缀）
cpp/_regress/_*

# 现场点云转出来的 ascii 副本（用 ply2ascii.py 随时重生成，不入库）
cpp/_regress/ubox.ply
cpp/_regress/ubox4.ply
