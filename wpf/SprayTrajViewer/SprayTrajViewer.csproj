<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HelixToolkit.Wpf" Version="3.1.2" />
  </ItemGroup>

  <!--
    核心算法库 SprayTraj.dll 由 cpp/SprayTrajCore 单独构建（CMake），不参与本工程编译。
    以前靠手工拷贝到 bin 目录，漏拷时界面会一直跑旧算法：
    截图看着"算法没改对"，其实是 exe 旁边躺着一个几天前的 DLL。
    这里在每次构建后强制同步，并把时间戳打进日志，避免再出现"改了没生效"的假象。
  -->
  <PropertyGroup>
    <SprayTrajCoreDll>$(MSBuildThisFileDirectory)..\..\cpp\SprayTrajCore\build\bin\Release\SprayTraj.dll</SprayTrajCoreDll>
  </PropertyGroup>

  <Target Name="SyncSprayTrajCore" AfterTargets="Build" Condition="Exists('$(SprayTrajCoreDll)')">
    <Copy SourceFiles="$(SprayTrajCoreDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="已同步 SprayTraj.dll -> $(OutDir)" />
  </Target>

  <Target Name="WarnMissingSprayTrajCore" AfterTargets="Build" Condition="!Exists('$(SprayTrajCoreDll)')">
    <Warning Text="找不到核心算法库：$(SprayTrajCoreDll)，请先构建 cpp/SprayTrajCore（cmake --build build --config Release）" />
  </Target>

  <!--
    标定配置跟着 exe 走：界面里「手眼矩阵」默认填的是相对路径 config\handeye_cam2base.txt，
    按程序目录解析。不复制的话，从 bin 里双击启动就会报"文件不存在"，
    而人明明看得见仓库根目录下有这么个文件 —— 这种"路径感"问题最费时间。
    整个 config 目录一起同步，以后加新配置文件不用再改工程。
  -->
  <PropertyGroup>
    <CalibConfigDir>$(MSBuildThisFileDirectory)..\..\config\</CalibConfigDir>
  </PropertyGroup>

  <Target Name="SyncCalibConfig" AfterTargets="Build" Condition="Exists('$(CalibConfigDir)')">
    <ItemGroup>
      <CalibFiles Include="$(CalibConfigDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(CalibFiles)" DestinationFolder="$(OutDir)config\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="已同步标定配置 @(CalibFiles->Count()) 个 -> $(OutDir)config" />
  </Target>

</Project>
